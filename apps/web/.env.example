# Public — safe in the client bundle; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. The post-build scan fails the build if this ever reaches a
# client chunk (delivery plan, S0).
SUPABASE_SECRET_KEY=sb_secret_...

# Shared with the pg_cron job, so only the sweep can trigger the sweep (D5).
SWEEP_SECRET=

# The canonical origin. Optional — the app reads the request's own host when this
# is unset — but pinning it stops an OAuth round trip that started on the
# vercel.app hostname from coming back to the custom domain, and vice versa.
NEXT_PUBLIC_SITE_URL=https://domains.karlos.dev
